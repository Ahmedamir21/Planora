{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:harness": "esbuild tests/harness.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/harness.mjs --log-level=error && node node_modules/.tmp/harness.mjs",
    "test:platform": "esbuild tests/platform-features.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/platform-features.mjs --log-level=error && node node_modules/.tmp/platform-features.mjs",
    "test:data": "esbuild tests/data-integrity.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/data-integrity.mjs --log-level=error && node node_modules/.tmp/data-integrity.mjs",
    "test:assistant": "esbuild tests/assistant-features.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/assistant-features.mjs --log-level=error && node node_modules/.tmp/assistant-features.mjs",
    "test:ssr": "esbuild tests/ssr.tsx --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/ssr.cjs --jsx=automatic --log-level=error && node node_modules/.tmp/ssr.cjs",
    "test:ui": "esbuild tests/ui-maxhours.tsx --bundle --platform=node --format=cjs --packages=external --jsx=automatic --outfile=node_modules/.tmp/ui-maxhours.cjs --log-level=error && node node_modules/.tmp/ui-maxhours.cjs && esbuild tests/ui-share.tsx --bundle --platform=node --format=cjs --packages=external --jsx=automatic --outfile=node_modules/.tmp/ui-share.cjs --log-level=error && node node_modules/.tmp/ui-share.cjs && esbuild tests/ui-yearcap.tsx --bundle --platform=node --format=cjs --packages=external --jsx=automatic --outfile=node_modules/.tmp/ui-yearcap.cjs --log-level=error && node node_modules/.tmp/ui-yearcap.cjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
