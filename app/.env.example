# Set actual values privately in the Planora Vercel project Environment Variables.
PLANORA_ADMIN_AHMED_USERNAME=ahmed
PLANORA_ADMIN_AHMED_PASSWORD_HASH=generated-separately-for-ahmed
PLANORA_ADMIN_YOUSSEF_USERNAME=youssef
PLANORA_ADMIN_YOUSSEF_PASSWORD_HASH=generated-separately-for-youssef
PLANORA_ADMIN_SESSION_SECRET=a-unique-random-secret-at-least-32-characters
# Durable drafts + audit history (Vercel Marketplace Upstash Redis).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-private-token
# Optional schedule assistant:
GEMINI_API_KEY=your-api-key
