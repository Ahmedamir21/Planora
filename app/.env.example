# Account usernames and display names: app/admin-accounts.ts
# Set actual values privately in the Planora Vercel project Environment Variables.
PLANORA_ADMIN_AHMED_PASSWORD_HASH=generated-separately-for-ahmed
PLANORA_ADMIN_YOUSSEF_PASSWORD_HASH=generated-separately-for-youssef
PLANORA_ADMIN_SESSION_SECRET=a-unique-random-secret-at-least-32-characters
# Durable drafts + audit history (Vercel Marketplace Upstash Redis).
# The Vercel integration can automatically provide KV_REST_API_URL + KV_REST_API_TOKEN instead.
# Either complete pair works; never paste real tokens into this file.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-private-token
# Optional schedule assistant:
GEMINI_API_KEY=your-api-key
# Optional no-domain email alerts via YOUR Google Apps Script deployment.
# See docs/REPORT_EMAIL.md. Add these only to private Vercel Production settings.
PLANORA_REPORT_MAIL_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
PLANORA_REPORT_MAIL_WEBHOOK_SECRET=generate-a-long-private-random-value
